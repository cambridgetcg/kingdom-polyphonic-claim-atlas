  "recordLifecycleStates": [
    {
      "id": "CURRENT_AS_OF",
      "definition": "The record is the current declared version only at the stated fixture date.",
      "establishesTruthOrFalsehood": false
    },
    {
      "id": "CORRECTED",
      "definition": "A later record identifies and repairs a declared defect in an earlier record.",
      "establishesTruthOrFalsehood": false
    },
    {
      "id": "WITHDRAWN",
      "definition": "A source ceases to advance a record without the atlas inferring why or whether its content was false.",
      "establishesTruthOrFalsehood": false
    },
    {
      "id": "SUPERSEDED",
      "definition": "A later record replaces an earlier record for a declared purpose and time.",
      "establishesTruthOrFalsehood": false
    },
    {
      "id": "RETRACTED",
      "definition": "A source formally removes a prior record from active reliance while historical provenance remains visible.",
      "establishesTruthOrFalsehood": false
    }
  ],
  "claimRegimes": [
    {
      "id": "EMPIRICAL",
      "definition": "A claim whose scoped subject matter is a declared observable condition in the synthetic fixture.",
      "assessmentLimit": "Requires a named comparison or observation and remains revisable."
    },
    {
      "id": "FORMAL_LOGICAL",
      "definition": "A claim about formal consequence, compatibility or contradiction under declared premises and rules.",
      "assessmentLimit": "Validity does not establish premise truth or real-world correspondence."
    },
    {
      "id": "INSTITUTIONAL",
      "definition": "A claim about a status created or recognized by a declared synthetic institution under a declared rule.",
      "assessmentLimit": "Institutional force does not establish an empirical claim outside its authority."
    },
    {
      "id": "PROCEDURAL",
      "definition": "A claim about conformance to a declared synthetic procedure, record or protocol.",
      "assessmentLimit": "Conformance and receipt validity do not establish semantic truth."
    },
    {
      "id": "INTERPRETIVE",
      "definition": "A claim about meaning, framing, significance or the best reading of declared material.",
      "assessmentLimit": "Multiple scoped interpretations may remain live."
    },
    {
      "id": "NARRATIVE_CLAIM_FRAGMENT",
      "definition": "An assessable claim fragment extracted from a separately represented story artifact.",
      "assessmentLimit": "A story as a whole is never reduced to one verdict; coherence, fidelity, correspondence, selection and omission remain separate."
    },
    {
      "id": "METAPHORICAL",
      "definition": "A non-literal comparison offered within a declared language practice.",
      "assessmentLimit": "Literal empirical tests may be outside the expression's declared speech act."
    },
    {
      "id": "FICTIONAL",
      "definition": "A proposition inside a declared invented world or fiction practice.",
      "assessmentLimit": "Fictional status is not deception and does not imply literal-world assertion."
    },
    {
      "id": "NORMATIVE",
      "definition": "A claim about what ought to be done or valued under declared reasons and commitments.",
      "assessmentLimit": "Empirical support alone does not derive the normative conclusion."
    },
    {
      "id": "SELF_REFERENTIAL",
      "definition": "A claim whose interpretation refers to itself or its own assessment status.",
      "assessmentLimit": "The Phase-0 atlas refuses untyped fixed-point adjudication."
    },
    {
      "id": "PHENOMENAL",
      "definition": "A first-person report of a declared synthetic subject's apparent experience or perception.",
      "assessmentLimit": "Record the report and its conditions without inferring private state, deception or being-wide reliability."
    },
    {
      "id": "PREDICTIVE",
      "definition": "A claim about a condition at a declared future fixture time under stated assumptions.",
      "assessmentLimit": "Assess only after the named horizon and preserve the distinction between a reasonable forecast and its eventual outcome."
    },
    {
      "id": "COUNTERFACTUAL",
      "definition": "A claim about what would occur under a declared alternative synthetic condition.",
      "assessmentLimit": "Requires an explicit model or comparison and cannot be collapsed into direct observation."
    },
    {
      "id": "PERFORMATIVE_OR_DIRECTIVE",
      "definition": "An utterance that declares, promises, requests, directs or constitutes a scoped institutional relation rather than merely describing one.",
      "assessmentLimit": "Assess felicity and authority separately from empirical correspondence and moral legitimacy."
    },
    {
      "id": "TESTIMONIAL",
      "definition": "A report attributed to a synthetic witness role about that role's declared access to an event or condition.",
      "assessmentLimit": "Assess the scoped report and access conditions only; never infer witness credibility, worth, identity or a person-wide score."
    },
    {
      "id": "CAUSAL",
      "definition": "A claim that one declared synthetic condition produced or changed another under an explicit causal model.",
      "assessmentLimit": "Temporal order, correlation and narrative sequence do not by themselves establish causation."
    },
    {
      "id": "DEFINITIONAL",
      "definition": "A claim about stipulated term use within a declared vocabulary or language practice.",
      "assessmentLimit": "Definition fixes scoped use; it neither discovers an empirical condition nor forces identity across languages."
    },
    {
      "id": "METAPHYSICAL_SOURCE_ATTRIBUTION",
      "definition": "A claim that an invented source record advances a stated metaphysical or theological referent proposition.",
      "assessmentLimit": "Phase 0 may check only the source attribution; support cannot be transferred to the referent proposition."
    },
    {
      "id": "METAPHYSICAL_REFERENT_PROPOSITION",
      "definition": "The metaphysical or theological referent proposition advanced by an invented source, represented separately from its attribution record.",
      "assessmentLimit": "Phase 0 provides no proof, disproof, equation, ranking or authority over the referent proposition or any tradition."
    }
  ],
  "methodVocabulary": [
    {
      "id": "DECLARED_FIXTURE_WORLD_COMPARISON",
      "definition": "Compare a claim only with explicitly declared synthetic world conditions.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "FORMAL_VALIDITY_CHECK",
      "definition": "Check whether a conclusion follows under the declared rule and premises.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "PROVENANCE_INTEGRITY_CHECK",
      "definition": "Check declared origin, signature or transformation continuity without assessing content correspondence.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "SOURCE_INDEPENDENCE_AUDIT",
      "definition": "Inspect whether apparently distinct reports share one declared upstream origin.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "NARRATIVE_SELECTION_AUDIT",
      "definition": "Compare selected, omitted and ordered events and attributed causes across narratives.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "AUTHORITY_SCOPE_CHECK",
      "definition": "Compare a speech act or official claim with its declared institutional authority and subject-matter limits.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "CITATION_EXISTENCE_CHECK",
      "definition": "Check whether a cited item exists in the fixture's declared catalogue without inferring content truth.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "TEMPORAL_SCOPE_CHECK",
      "definition": "Compare a claim's time scope with the fixture's declared update or correction sequence.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "INTERPRETATION_BOUNDARY_CHECK",
      "definition": "Inspect genre, translation, ambiguity, metaphor or fiction before selecting an assessment method.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "TESTIMONY_UPTAKE_AUDIT",
      "definition": "Compare evidential access with institutional uptake without scoring a witness or source.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "CAUSAL_MODEL_CHECK",
      "definition": "Inspect whether a declared causal model and discriminating conditions support more than temporal order or correlation.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "NORMATIVE_REASON_BOUNDARY_CHECK",
      "definition": "Inspect declared normative premises and prevent empirical observations from silently deriving an ought.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "SELF_REFERENCE_STRATIFICATION_CHECK",
      "definition": "Enforce downward-only L0 claim, L1 assessment and L2 audit targeting without a fixed-point verdict.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "PREDICTIVE_HORIZON_CHECK",
      "definition": "Compare a scoped prediction only after its named fixture horizon while preserving ex-ante warrant separately.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "COUNTERFACTUAL_MODEL_COMPARISON",
      "definition": "Compare declared alternative-world models without treating an unobserved counterfactual as direct observation.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "PHENOMENAL_REPORT_BOUNDARY_CHECK",
      "definition": "Record a first-person phenomenal report and its expression conditions without inferring private state or external correspondence.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "TESTIMONIAL_ACCESS_CHECK",
      "definition": "Inspect the declared access conditions of one synthetic testimony without producing a witness-wide assessment.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "DEFINITIONAL_SCOPE_CHECK",
      "definition": "Inspect whether a stipulated definition is used within its declared vocabulary and language practice.",
      "establishesTruthBeyondFixture": false
    },
    {
      "id": "METAPHYSICAL_ATTRIBUTION_BOUNDARY_CHECK",
      "definition": "Distinguish the record that an invented source advances a metaphysical or theological referent claim from adjudication of that referent proposition.",
      "establishesTruthBeyondFixture": false
    }
  ],
